{
  "expo": {
    "name": "Reportes de Tarjetas",
    "slug": "reporte-tarjetas-mvp",
    "owner": "nicolasets-team",
    "description": "Reportes de tarjetas para clientes de Inforhard S.R.L",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/branding/logo.png",
    "scheme": "reportestarjetas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/logo.png",
      "bundleIdentifier": "com.inforhard.reportestarjetas",
      "supportsTablet": true
    },
    "android": {
      "package": "com.inforhard.reportestarjetas",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EE",
        "foregroundImage": "./assets/branding/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#008A46",
          "image": "./assets/branding/logo_splash.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcd7d9e0-f840-4d79-8af3-b5ed9078fa63"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fcd7d9e0-f840-4d79-8af3-b5ed9078fa63"
    }
  }
}
